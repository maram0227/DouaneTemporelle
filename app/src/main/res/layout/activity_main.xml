<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main_mf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F2F5FA">

    <TextView
        android:id="@+id/tv_titre_mf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titre_app"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tv_nom_mf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nom_voyageur"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/et_nom_mf"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_nom"
        android:inputType="textPersonName"
        android:autofillHints="personName" />

    <TextView
        android:id="@+id/tv_naissance_mf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/annee_naissance"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/et_naissance_mf"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_naissance"
        android:inputType="number"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/tv_destination_mf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/annee_destination"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/et_destination_mf"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_destination"
        android:inputType="number"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/tv_motif_mf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/motif_voyage"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/sp_motif_mf"
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <Button
        android:id="@+id/btn_inspecter_mf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_inspecter"
        android:layout_marginTop="25dp" />

</LinearLayout>
